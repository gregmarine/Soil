<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without this, Android 11 shows an app no other app: the home screen's grid and the side
         menu list every app that has a launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SoilApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soil">

        <!-- The home screen, which is the library. It becomes the device's HOME with the shell. -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".bootstrap.RecoveryKeyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- adjustResize: the entry stays above the keyboard, which is never hidden. -->
        <activity
            android:name=".bootstrap.UnlockActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- adjustResize: the passphrase dialogs stay above the keyboard. -->
        <activity
            android:name=".encryption.EncryptionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The Scratch Pad is opened from the side menu over whatever app is in front, so it has
             a task of its own: Back returns to that app, not to Soil's home. It is not an entry
             in the recent apps. -->
        <activity
            android:name=".pad.ScratchPadActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.pad"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

    </application>

</manifest>
