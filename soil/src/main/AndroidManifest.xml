<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Without this, Android 11 shows an app no other app: the home screen's app drawer lists
         every app that has a launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The Sprout apps: each says which kind of item it opens. -->
        <intent>
            <action android:name="com.symmetricalpalmtree.soil.action.OPEN_ITEM" />
        </intent>
        <!-- The firmware's launcher, bound to hold its side menu shut. -->
        <package android:name="com.ratta.supernote.launcher" />
    </queries>

    <!-- The seam's first guard. Android grants a signature permission only to an app signed with
         the same key as the app that declares it, and refuses the bind to any other. It is named
         after the install, so a debug Soil and a release Soil never declare the same name. -->
    <permission
        android:name="${applicationId}.permission.SEAM"
        android:protectionLevel="signature" />

    <!-- Soil holds its own permission: the screen an app opens an item in is guarded by it, and
         Soil is what starts that screen. -->
    <uses-permission android:name="${applicationId}.permission.SEAM" />

    <application
        android:name=".SoilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soil">

        <!-- The home screen, which is the library. It offers itself as the device's home screen;
             whether it IS the home screen is set over adb (see README.md). It keeps its launcher
             entry, so it can be reached from the firmware's own menu when it is not. -->
        <activity
            android:name=".home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".home.HiddenAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".bootstrap.RecoveryKeyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- adjustResize: the entry stays above the keyboard, which is never hidden. -->
        <activity
            android:name=".bootstrap.UnlockActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- adjustResize: the passphrase dialogs stay above the keyboard. -->
        <activity
            android:name=".encryption.EncryptionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- The Scratch Pad is opened from the side menu over whatever app is in front, so it has
             a task of its own: Back returns to that app, not to Soil's home. It is not an entry
             in the recent apps. -->
        <activity
            android:name=".pad.ScratchPadActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.pad"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <!-- The paper library. In browse mode it is Soil's own; in pick mode a Sprout app starts
             it for a result, so it is exported behind the seam permission, and it checks the
             caller's certificate again itself. -->
        <activity
            android:name=".templates.TemplatesActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.SEAM"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.PICK_TEMPLATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Save as template, Soil's half: a Sprout app parks a picture through the seam and
             starts this for the name and the folder. -->
        <activity
            android:name=".templates.SaveTemplateActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.SEAM"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Soil.Translucent"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.SAVE_TEMPLATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".library.NewNotebookActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing" />

        <!-- An item of the library for a Sprout app: the link picker's notebook shelves. -->
        <activity
            android:name=".library.ItemPickerActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.SEAM"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.PICK_ITEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The tag screen: one item's tags, or one page's. Started for a result by the library
             and by the Sprout apps; exported behind the seam permission and the caller check. -->
        <activity
            android:name=".tags.TagsActivity"
            android:exported="true"
            android:permission="${applicationId}.permission.SEAM"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.TAGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".library.FolderPickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait" />

        <!-- The shell: the side bars, in every app. Turned on over adb (see README.md); Soil
             works without it. -->
        <service
            android:name=".shell.SoilBarService"
            android:exported="true"
            android:label="@string/bar_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bar_service" />
        </service>

        <!-- The seam: what the Sprout apps bind to. Exported, and guarded by the permission
             above; every call checks the caller's certificate again. -->
        <service
            android:name=".seam.SoilSeamService"
            android:exported="true"
            android:permission="${applicationId}.permission.SEAM" />

    </application>

</manifest>
