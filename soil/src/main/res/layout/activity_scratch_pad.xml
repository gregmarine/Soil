<?xml version="1.0" encoding="utf-8"?>
<!--
  The Scratch Pad: full-bleed paper with two thin chrome bars overlaid. The PaperView is added
  into paperContainer programmatically.

  Both bars go to paper.setExclusionRects (via PaperChrome) after layout, so ink never lands under
  chrome. Chrome sits flush at the top edge.

  openingOverlay starts VISIBLE: the pad covers its own first frame, so the launch reads as one
  continuous "Opening…".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite">

    <FrameLayout
        android:id="@+id/paperContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/paperWhite"
        android:orientation="vertical">

        <!-- A FrameLayout, not a row: the title is centred on the SCREEN, so it stays put
             whatever flanks it. -->
        <FrameLayout
            android:id="@+id/topBarRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="@string/scratch_title"
                android:textColor="@color/inkBlack"
                android:textSize="16sp" />

            <!-- Back, then the tools: the whole of what you do *on* this page lives on one edge. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_scratch_back"
                    android:src="@drawable/ic_arrow_left" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPen"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_tool_pen"
                    android:src="@drawable/ic_pen" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnEraser"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_tool_eraser"
                    android:src="@drawable/ic_eraser" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnLasso"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_tool_lasso"
                    android:src="@drawable/ic_lasso" />
            </LinearLayout>

            <!-- Copy the page's ink to the clipboard, for a notebook or a document to paste. -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSend"
                style="@style/Widget.Soil.ToolbarButton"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/scratch_copy_page"
                android:src="@drawable/ic_copy" />


        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/paperWhite"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <!-- Pages only, centred on the SCREEN. -->
        <FrameLayout
            android:id="@+id/bottomBarRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPrevPage"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_prev_page"
                    android:src="@drawable/ic_page_prev" />

                <TextView
                    android:id="@+id/pageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:singleLine="true"
                    android:textColor="@color/inkBlack"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnNextPage"
                    style="@style/Widget.Soil.ToolbarButton"
                    android:contentDescription="@string/cd_next_page"
                    android:src="@drawable/ic_page_next" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- The selection's floating bar. Placed by margins from SelectionAnchor.place; its buttons
         are built in code. -->
    <LinearLayout
        android:id="@+id/selectionToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/shape_dialog_bordered"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />

    <!-- The collapsed chrome — what shows while both bars are hidden: the corner
         tool button at top-right wearing the armed tool's glyph, and, hung under it on a tap, the
         mini toolbar and its overflow row (buttons built in code — CollapsedChrome, :paper).
         The button is GONE while the bars show; ChromeToggle flips it with them. All three sit
         after every bar they may overlap and BEFORE openingOverlay, which stays topmost while the
         screen opens — a corner button laid over it would take the taps the overlay is there to
         swallow. -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/collapsedKnob"
        style="@style/Widget.Soil.ToolbarButton"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/shape_dialog_bordered"
        android:src="@drawable/ic_pen"
        android:visibility="gone"
        android:contentDescription="@string/collapsed_tools" />

    <LinearLayout
        android:id="@+id/collapsedBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/shape_dialog_bordered"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/collapsedOverflow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/shape_dialog_bordered"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />

    <!-- "Opening…". Full-screen but transparent and clickable: it swallows the second tap a slow e-ink refresh
         invites while the page is still being read. -->
    <FrameLayout
        android:id="@+id/openingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_dialog_bordered"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scratch_opening"
                android:textColor="@color/inkBlack"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- The eraser button's sub-bar — Point / Lasso, hung under the armed eraser
         button by SelectionAnchor.placeUnder. Buttons are built in code (EraserBar, :paper).
         A later sibling than anything it could overlap (the top bar's buttons are inside the
         earlier LinearLayout) — the floating-bar rule. It is GONE the whole
         time openingOverlay is up (the bar cannot open before the page is on the paper), so the
         overlay stays the topmost VISIBLE child while opening. -->
    <LinearLayout
        android:id="@+id/eraserBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/shape_dialog_bordered"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone" />


</FrameLayout>
