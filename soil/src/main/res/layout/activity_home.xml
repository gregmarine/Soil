<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen: two views under one top bar. The library is the one it opens on; the app
     drawer is the other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <!-- Top bar: the two views at the start; at the end, what makes things (the library) or the
         drawer's one action, and the way in while the library is locked. The library's filters
         are on its own path line, and Backup and Import on its bottom bar (decision 2026-10-03). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <!-- The view that is showing wears a border. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnLibrary"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_soil"
            android:contentDescription="@string/cd_view_library" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnApps"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_apps"
            android:contentDescription="@string/cd_view_apps" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- The library's own actions; absent on the drawer. New notebook needs an app that makes
             notebooks, New sketchbook one that makes sketchbooks, and New document one that makes
             documents; each is absent without its app. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewNotebook"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_notebook_plus"
            android:contentDescription="@string/cd_new_notebook"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewSketchbook"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_pencil_plus"
            android:contentDescription="@string/cd_new_sketchbook"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewDocument"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_file_plus"
            android:contentDescription="@string/cd_new_document"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNewFolder"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_folder_plus"
            android:contentDescription="@string/cd_new_folder_library"
            android:visibility="gone" />

        <!-- The app drawer's own action; absent on the library. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnHiddenApps"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_eye_off"
            android:contentDescription="@string/cd_hidden_apps"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRecoveryKey"
            style="@style/Widget.Soil.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/action_recovery_key"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUnlock"
            style="@style/Widget.Soil.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/action_unlock"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- The library out of reach: the open is tried again on a tap. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain"
            style="@style/Widget.Soil.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/action_try_again"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The library: the items, a page at a time, or a line that says why there are none. -->
        <FrameLayout
            android:id="@+id/libraryView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- The library browser: the path, the cards, its own pager. -->
            <include
                android:id="@+id/browser"
                layout="@layout/view_library_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/libraryNote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="28dp">

                <TextView
                    android:id="@+id/libraryMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:textSize="18sp"
                    android:textColor="@color/inkBlack" />

                <!-- Said only while the shell is off: with it off the side bars open the
                     firmware's own menu, and this is the one place that explains why. -->
                <TextView
                    android:id="@+id/shellNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/shell_off"
                    android:textSize="14sp"
                    android:textColor="@color/inkBlack"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- The app drawer: the apps the person has not hidden, a page at a time. -->
        <FrameLayout
            android:id="@+id/appsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Turned by a sideways swipe, and by the pager below. -->
            <com.symmetricalpalmtree.soil.home.PageSwipeLayout
                android:id="@+id/appGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/appsEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="28dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/apps_empty"
                android:textSize="18sp"
                android:textColor="@color/inkBlack"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- The drawer's bottom bar: its pager. The library's bottom bar is the browser's own. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_page_previous" />

            <TextView
                android:id="@+id/pageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_page_next" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
