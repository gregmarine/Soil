<?xml version="1.0" encoding="utf-8"?>
<!-- A full-screen click-eater while something long runs, with the stage it is at and, where the
     work can be stopped between its steps, Cancel under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/importStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/inkBlack"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/importCancel"
            style="@style/Widget.Soil.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/cancel"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
