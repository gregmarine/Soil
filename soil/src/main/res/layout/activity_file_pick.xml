<?xml version="1.0" encoding="utf-8"?>
<!-- A file for a Sprout app: a top bar with Back and the title, and the question over it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/file_pick_title"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Soil.ToolbarButton"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/cd_file_pick_back"
            android:src="@drawable/ic_arrow_left" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/file_pick_body"
        android:textColor="@color/inkBlack"
        android:textSize="16sp" />
</LinearLayout>
