<?xml version="1.0" encoding="utf-8"?>
<!-- The side menu: a panel on the right edge over whatever is in front. The rest of the screen
     is a scrim that closes the menu on a tap; it is clear, so the app underneath stays readable.
     There is no title and no close button: the room goes to rows. The rows are built in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="@dimen/menu_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/shape_menu_panel"
        android:clickable="true"
        android:paddingStart="2dp">

        <!-- What Soil itself offers: Home and the Scratch Pad. -->
        <LinearLayout
            android:id="@+id/ownRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
