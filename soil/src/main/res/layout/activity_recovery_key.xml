<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/recovery_title"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/inkBlack" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCopy"
            style="@style/Widget.Soil.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:text="@string/recovery_copy"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            style="@style/Widget.Soil.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toolbar_button_size"
            android:layout_marginStart="8dp"
            android:text="@string/recovery_continue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recovery_body"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/inkBlack" />

        <TextView
            android:id="@+id/keyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/shape_bordered"
            android:padding="18dp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="18sp"
            android:letterSpacing="0.02"
            android:textColor="@color/inkBlack" />

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkSaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="@dimen/toolbar_button_size"
            android:text="@string/recovery_saved"
            android:textSize="16sp"
            android:textColor="@color/inkBlack" />

    </LinearLayout>

</LinearLayout>
