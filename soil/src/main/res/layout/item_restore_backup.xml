<?xml version="1.0" encoding="utf-8"?>
<!-- One backup the chosen source holds: its name over its count, size and date. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="8dp"
    android:background="@drawable/shape_bordered"
    android:padding="14dp">

    <TextView
        android:id="@+id/restoreRowName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/inkBlack"
        android:textSize="18sp"
        android:singleLine="true"
        android:ellipsize="middle" />

    <TextView
        android:id="@+id/restoreRowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/inkBlack"
        android:textSize="14sp" />
</LinearLayout>
