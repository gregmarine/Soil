<?xml version="1.0" encoding="utf-8"?>
<!-- The library browser: the path (or a shelf's title) at the head with a back arrow, the paged
     card grid, and the pager. The actions on the folder are the host's own top bar; this is where
     you stand and what is here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browserRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paperWhite">

    <LinearLayout
        android:id="@+id/pathBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/cd_up_folder"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/breadcrumbScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/shelfTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="18dp"
            android:paddingEnd="12dp"
            android:textSize="16sp"
            android:textColor="@color/inkBlack"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <com.symmetricalpalmtree.soil.home.PageSwipeLayout
        android:id="@+id/gridContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/library_empty"
            android:textSize="16sp"
            android:textColor="@color/inkBlack" />
    </com.symmetricalpalmtree.soil.home.PageSwipeLayout>

    <LinearLayout
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="invisible">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFirst"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_page_first"
            android:contentDescription="@string/cd_first_page" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPrev"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_page_prev"
            android:contentDescription="@string/cd_prev_page" />

        <TextView
            android:id="@+id/pageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/inkBlack" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnNext"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_page_next"
            android:contentDescription="@string/cd_next_page" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnLast"
            style="@style/Widget.Soil.ToolbarButton"
            android:src="@drawable/ic_page_last"
            android:contentDescription="@string/cd_last_page" />
    </LinearLayout>
</LinearLayout>
