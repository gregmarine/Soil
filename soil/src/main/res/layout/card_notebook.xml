<?xml version="1.0" encoding="utf-8"?>
<!-- One item: its cover (or its paper, or nothing) over its name and date. The pin badge floats
     in the cover's top-right corner on a bordered white chip; the kind glyph in the top-left, so an
     item says what it is at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_selectable_card"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/paperWhite"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/kindGlyph"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:padding="2dp"
            android:background="@drawable/bg_pin_badge"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/pinBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:padding="2dp"
            android:background="@drawable/bg_pin_badge"
            android:src="@drawable/ic_pinned"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/cd_pinned_badge" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/inkBlack"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/cardDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/inkBlack"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
