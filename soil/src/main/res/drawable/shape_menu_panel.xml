<?xml version="1.0" encoding="utf-8"?>
<!-- The side menu's panel: paper, with a black rule down its left edge. Black, never grey: a grey
     border is invisible on e-ink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inkBlack" />
        </shape>
    </item>
    <item android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/paperWhite" />
        </shape>
    </item>
</layer-list>
