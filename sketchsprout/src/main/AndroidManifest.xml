<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The seam's first guard. Android grants it only to an app signed with Soil's key. -->
    <uses-permission android:name="${soilPackage}.permission.SEAM" />

    <queries>
        <package android:name="${soilPackage}" />
    </queries>

    <application
        android:name=".SketchsproutApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soil">

        <!-- The icon in Soil's app drawer and the row in its side menu: the sketchbook last open,
             or the library. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A sketchbook, opened by Soil and by nothing else: the screen is guarded by Soil's
             permission. What arrives is the sketchbook's id, or the name of one to make. -->
        <activity
            android:name=".sketch.SketchActivity"
            android:exported="true"
            android:permission="${soilPackage}.permission.SEAM"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.OPEN_ITEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.soil.kind"
                android:value="sketchbook" />
        </activity>

    </application>

</manifest>
