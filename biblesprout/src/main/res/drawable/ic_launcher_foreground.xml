    <path android:fillColor="@android:color/transparent" android:strokeColor="#000000" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M54 38c0 -6 4 -10 10 -10c0 6 -4 10 -10 10z" />
