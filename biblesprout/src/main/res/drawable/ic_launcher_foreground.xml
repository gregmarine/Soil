    <path android:fillColor="@android:color/transparent" android:strokeColor="#000000" android:strokeWidth="4" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M32 74a22 22 0 0 1 22 0a22 22 0 0 1 22 0" />
