<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The seam's first guard. Android grants it only to an app signed with Soil's key. -->
    <uses-permission android:name="${soilPackage}.permission.SEAM" />

    <queries>
        <package android:name="${soilPackage}" />
    </queries>

    <application
        android:name=".BiblesproutApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soil">

        <!-- The icon in Soil's app drawer and the row in its side menu: the reader where it was
             left. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The reader, opened by Soil on a passage (a link followed) and by nothing else: the
             screen is guarded by Soil's permission. What arrives is a wire, or nothing. Standard
             launch mode on purpose: the reader opens over whatever followed the link, and its own
             Full chapter and cross-reference hops stack over it, so Back always comes back.

             `configChanges="keyboard|keyboardHidden"`: the Search panel has a text field, and a
             keyboard attached or removed must not recreate the screen. -->
        <activity
            android:name=".BibleActivity"
            android:exported="true"
            android:permission="${soilPackage}.permission.SEAM"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.OPEN_BIBLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
