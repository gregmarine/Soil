<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The seam's first guard. Android grants it only to an app signed with Soil's key. -->
    <uses-permission android:name="${soilPackage}.permission.SEAM" />

    <queries>
        <package android:name="${soilPackage}" />
    </queries>

    <application
        android:name=".DocsproutApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Soil">

        <!-- The icon in Soil's app drawer and the row in its side menu: the document last open,
             or the library. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A document, opened by Soil and by nothing else: the screen is guarded by Soil's
             permission. What arrives is the document's id, or the name of one to make.

             The keyboard rules are Ratta's: hardware keys arrive only while the IME is shown, so
             the window resizes for it and never hides it, and a keyboard attaching must not
             rebuild the screen. -->
        <activity
            android:name=".editor.DocumentActivity"
            android:exported="true"
            android:permission="${soilPackage}.permission.SEAM"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden"
            android:windowSoftInputMode="stateUnchanged|adjustResize">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.OPEN_ITEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.soil.kind"
                android:value="document" />
        </activity>

        <!-- The document for Soil's export and import, bound by Soil and nothing else. -->
        <service
            android:name=".export.RenderService"
            android:exported="true"
            android:permission="${soilPackage}.permission.SEAM">
            <intent-filter>
                <action android:name="com.symmetricalpalmtree.soil.action.RENDER" />
            </intent-filter>
            <meta-data
                android:name="com.symmetricalpalmtree.soil.kind"
                android:value="document" />
        </service>

    </application>

</manifest>
