<?xml version="1.0" encoding="utf-8"?>
<!-- A document: one bar over the text. The window is adjustResize, so the text is what gives way
     to the keyboard and the bar stays where it is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paperWhite"
    android:orientation="vertical">

    <!-- A FrameLayout, not a row: the title is centred on the SCREEN, so it stays put whatever
         flanks it. -->
    <FrameLayout
        android:id="@+id/topBarRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_bar_thickness"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Soil.ToolbarButton"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_x" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/inkBlack" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Markdown source. Monospace because columns carry meaning here. It is not shown
             until the document is read, and it never saves its own state: what it holds is the
             document's, and a screen rebuilt for another document must not bring the old words
             with it. -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paperWhite"
            android:gravity="top|start"
            android:hint="@string/document_hint"
            android:imeOptions="flagNoFullscreen|flagNoExtractUi"
            android:inputType="textMultiLine|textCapSentences|textNoSuggestions"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp"
            android:saveEnabled="false"
            android:scrollbars="vertical"
            android:textColor="@color/inkBlack"
            android:textColorHint="@color/inkLight"
            android:textSize="16sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/opening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_dialog_bordered"
            android:padding="24dp"
            android:text="@string/open_opening"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />

    </FrameLayout>

</LinearLayout>
