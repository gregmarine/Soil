<?xml version="1.0" encoding="utf-8"?>
<!-- "Recognising…": a box, not a dialog, over a transparent shield that swallows the second tap a
     slow refresh invites. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bordered"
        android:padding="24dp">

        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recognize_recognizing"
            android:textColor="@color/inkBlack"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
