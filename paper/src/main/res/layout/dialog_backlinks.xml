<?xml version="1.0" encoding="utf-8"?>
<!-- The backlinks panel ("what links into this?"): the Bible reader's Notes panel shared with the
     calendar's Links. A right-hand panel: the header then the arrow, the paginated body, the
     pager. The owner branches in code on window width (full-screen below 480 dp, a 60 % sidebar
     at or above) and sets the panel's width; the back arrow shows only in the full-screen form. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backlinksRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/backlinksPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@drawable/shape_backlinks_sidebar"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/backlinksTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/inkBlack"
                android:textSize="20sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBacklinksBack"
                style="@style/Widget.Soil.ToolbarButton"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="@string/cd_backlinks_back" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <FrameLayout
            android:id="@+id/backlinksBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/backlinksRows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/backlinksEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/inkBlack"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/inkBlack" />

        <LinearLayout
            android:id="@+id/backlinksPager"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_bar_thickness"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="invisible">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBacklinksFirst"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_first"
                android:contentDescription="@string/cd_backlinks_first" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBacklinksPrev"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_prev"
                android:contentDescription="@string/cd_backlinks_prev" />

            <TextView
                android:id="@+id/backlinksPageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="@color/inkBlack" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBacklinksNext"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_next"
                android:contentDescription="@string/cd_backlinks_next" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBacklinksLast"
                style="@style/Widget.Soil.ToolbarButton"
                android:src="@drawable/ic_page_last"
                android:contentDescription="@string/cd_backlinks_last" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
