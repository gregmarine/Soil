<?xml version="1.0" encoding="utf-8"?>
<!-- One backlinks row: the place that links ("Study · Page 4", "Sermon · Document", 20sp), then
     what it links to there (13sp). Both inkBlack: secondary text is smaller, never grey. The
     detail line is one line, so a page naming many things ellipsizes. 1dp separator below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backlinkEntryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/backlinkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/inkBlack"
            android:textSize="20sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/backlinkDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/inkBlack"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="24dp"
        android:background="@color/inkBlack" />

</LinearLayout>
