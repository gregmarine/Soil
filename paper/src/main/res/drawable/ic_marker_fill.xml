<?xml version="1.0" encoding="utf-8"?>
<!--
    The marker's BODY as a fill — `ic_marker`'s first path, closed with `z`, with no stroke at all
    and the same 24 viewport. Layered UNDER `ic_marker` it lands exactly inside that glyph: the
    outline's 2 px stroke is centred on this very path, so it covers the fill's own edge on both
    sides and the outline stays solid black at every shade. The two cross lines and the cap are
    not part of the body and so are not here.

    Tinted at runtime with the armed shade (`ShadeIcon.marker`) and never drawn on its own; the
    black declared here is what an untinted instance reads as, level 0 of the ladder.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/inkBlack"
        android:pathData="M3 19h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4z"/>
</vector>
