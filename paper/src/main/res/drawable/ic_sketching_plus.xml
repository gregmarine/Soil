<?xml version="1.0" encoding="utf-8"?>
<!-- New sketchbook — Tabler "sketching", the Garden's sketchbook glyph, with a plus in its
     bottom-left corner: the stroke drawn at three quarters and kept to the top-right, the way
     Tabler's own photo-plus shrinks its frame, and the plus at (5,19) on 2..8 arms, the mirror of
     the arms notebook-plus and file-plus use (Greg, 2026-10-10: on the right it looked off; before
     it, pencil-plus). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The stroke, scaled towards the top-right; its width held at 2 on the glass. -->
    <group android:scaleX="0.75" android:scaleY="0.75" android:translateX="5.5" android:translateY="1">
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="@color/inkBlack"
            android:strokeWidth="2.667"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M4 15c2 -4.97 7.356 -11 9 -11c4.25 0 -5.5 11.958 -3 13s5.65 -6.678 7.4 -5.902c1.75 .777 -1.05 7.589 -.3 8.63s3.15 -.897 3.9 -2.728" />
    </group>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2 19h6" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5 16v6" />
</vector>
