<?xml version="1.0" encoding="utf-8"?>
<!-- New sketchbook — Tabler "sketching", the Garden's sketchbook glyph, with a plus cut into its
     corner the way Tabler's own photo-plus does it: the stroke drawn at three quarters so it
     stops short of the bottom-right, and the plus in the notch at (19,19) on the same 16..22 arms
     notebook-plus and file-plus use (Greg, 2026-10-10; before it, pencil-plus). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The stroke, scaled to the top-left; its width held at 2 on the glass. -->
    <group android:scaleX="0.75" android:scaleY="0.75" android:translateX="1" android:translateY="1">
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="@color/inkBlack"
            android:strokeWidth="2.667"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M4 15c2 -4.97 7.356 -11 9 -11c4.25 0 -5.5 11.958 -3 13s5.65 -6.678 7.4 -5.902c1.75 .777 -1.05 7.589 -.3 8.63s3.15 -.897 3.9 -2.728" />
    </group>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M16 19h6" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/inkBlack"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M19 16v6" />
</vector>
